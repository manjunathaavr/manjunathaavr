# Optional — cloud sync for admin (see users from all devices)
# Vercel no longer has "KV" under Storage. Use Marketplace instead:
# 1. Vercel project → Marketplace (or Storage → Browse Marketplace)
# 2. Search "Upstash" → Redis → Add integration → connect this project
# 3. Redeploy — Vercel adds UPSTASH_REDIS_REST_URL + UPSTASH_REDIS_REST_TOKEN
# Or create free Redis at https://upstash.com and paste REST URL + token here:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Get keys from https://dashboard.razorpay.com/app/keys
# Use test keys while developing.

# demo = simulate ₹1 unlock locally (default when key is empty)
# razorpay = open Razorpay Checkout
NEXT_PUBLIC_PAYMENT_MODE=demo

# Publishable key only (rzp_test_... or rzp_live_...). Never put the secret key here.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Optional — recommended for production (your backend):
# POST creates a Razorpay order, returns { "orderId": "order_xxx" }
NEXT_PUBLIC_PAYMENT_ORDER_URL=
# POST verifies signature, returns { "ok": true }
NEXT_PUBLIC_PAYMENT_VERIFY_URL=
